          "info": {
            "name": "Bridge across chains",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.wallet.paysponge.com/api/transactions/bridge",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Bridge across chains via POST."
        }
      ]
